menu "Friday assistant"

config FRIDAY_BACKEND_WS_URI
    string "Friday backend WebSocket URI"
    default "ws://192.168.4.60:8000/ws/device/friday-p3a"
    help
        WebSocket endpoint used by this device. The backend must listen on a
        LAN-accessible interface. Plain ws:// is acceptable only on a trusted
        development network; production firmware must use authenticated wss://.

endmenu
