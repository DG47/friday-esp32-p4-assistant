menu "Friday assistant"

config FRIDAY_BACKEND_WS_URI
    string "Friday backend WebSocket URI"
    default "wss://192.168.4.38:8000/ws/device/friday-p3a"
    help
        WebSocket endpoint used by this device. The backend must listen on a
        LAN-accessible interface and present a certificate signed by the
        Friday CA embedded in this firmware. Plain ws:// is rejected.

config FRIDAY_DISCOVERY_PORT
    int "Friday backend UDP discovery port"
    range 1024 65535
    default 8334
    help
        UDP port used to discover the backend on the current LAN before falling
        back to FRIDAY_BACKEND_WS_URI.

config FRIDAY_REDISCOVERY_FAILURES
    int "Reconnect failures before backend rediscovery"
    range 2 20
    default 5
    help
        Consecutive unauthenticated WebSocket disconnects allowed before the
        device retries UDP discovery and replaces its saved endpoint only after
        the discovered backend authenticates successfully.

config FRIDAY_AUDIO_DIGITAL_GAIN
    int "Digital gain applied to streamed microphone PCM"
    range 1 32
    default 8

config FRIDAY_VAD_INITIAL_NOISE_RMS
    int "Initial microphone noise-floor RMS"
    range 1 1000
    default 30

config FRIDAY_VAD_MIN_SPEECH_RMS
    int "Minimum speech-start RMS"
    range 1 32767
    default 50

config FRIDAY_VAD_SPEECH_RATIO_PERCENT
    int "Speech threshold as percent of ambient noise"
    range 100 1000
    default 150

config FRIDAY_VAD_SPEECH_START_MS
    int "Continuous speech required to start a turn (ms)"
    range 20 1000
    default 60

config FRIDAY_VAD_MIN_SILENCE_RMS
    int "Minimum trailing-silence RMS threshold"
    range 1 32767
    default 45

config FRIDAY_VAD_SILENCE_RATIO_PERCENT
    int "Silence threshold as percent of ambient noise"
    range 100 500
    default 135

config FRIDAY_VAD_SILENCE_END_MS
    int "Trailing silence required to submit a turn (ms)"
    range 200 3000
    default 800

config FRIDAY_AEC_BARGE_IN
    bool "Experimental echo-cancelled spoken interruption"
    default n
    help
        Enables 16kHz Espressif AEC using a bounded software playback reference.
        Requires physical reference-delay calibration and acoustic validation.
        Missing reference suppresses microphone frames; half-duplex is default.

config FRIDAY_AEC_REFERENCE_DELAY_MS
    int "Playback reference alignment delay (ms)"
    depends on FRIDAY_AEC_BARGE_IN
    range 0 200
    default 60

endmenu
