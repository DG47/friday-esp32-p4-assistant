# Copy to .env. Never commit real keys.
ASSISTANT_ENV=development
ASSISTANT_TIMEZONE=America/New_York
ASSISTANT_USER_NAME=Dhruv
ASSISTANT_PROVIDER=auto
ASSISTANT_AUTO_PROVIDER_PREFERENCE=openai
ASSISTANT_REMINDER_POLL_SECONDS=1
ASSISTANT_REMINDER_RETRY_SECONDS=90
ASSISTANT_REMINDER_MAX_ATTEMPTS=10
ASSISTANT_JOB_TIMEOUT_SECONDS=120
ASSISTANT_JOB_MAX_AGE_SECONDS=300
ASSISTANT_JOB_CONCURRENCY=4
ASSISTANT_CONFIRMATION_TIMEOUT_SECONDS=300
ASSISTANT_DISCOVERY_PORT=8334
ASSISTANT_PUBLIC_PORT=8000
ASSISTANT_PUBLIC_SCHEME=wss
# Generate with: openssl rand -hex 32
ASSISTANT_SIMULATOR_TOKEN=
ASSISTANT_SIMULATOR_DEVICE_ID=friday-p3a
ASSISTANT_ADMIN_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.6:latest
OPENAI_TEXT_MODEL=gpt-5.4-mini
ANTHROPIC_TEXT_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1024
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
STT_PROVIDER=faster-whisper
STT_MODEL=base.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
STT_MAX_SECONDS=15
